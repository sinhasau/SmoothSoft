# Database
# IMPORTANT: the app connects as `salon_app`, a role that does NOT own the
# tables. Postgres RLS policies are silently bypassed for the owning role
# (and superusers) — verified locally: connecting as the migration-owning
# role returned rows across simulated tenants even with RLS enabled, and
# connecting as salon_app correctly isolated them. Use DATABASE_MIGRATE_URL
# (owner) only for running migrations; the app itself must always use
# DATABASE_URL (salon_app).
DATABASE_URL=postgres://salon_app:salon_app_dev_password@localhost:5432/salon_platform
DATABASE_MIGRATE_URL=postgres://salon:salon_dev_password@localhost:5432/salon_platform

# Redis (sessions, WebSocket pub/sub, BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Dev-only auth (NOT production auth — see docs/ARCHITECTURE-data-and-perspectives.md
# Part 2 for the real role/permission model this stands in for)
JWT_SECRET=change_me_dev_only

# Stripe Connect (see SYSTEM-ARCHITECTURE-platform.md §4 — Connect, not plain Stripe,
# because locations/booth-renters each need their own payout). Card entry is via
# the Stripe Payment Element — raw card numbers never reach this app. Leave unset
# to run with the processor in "not configured" state (external/manual path only).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Square (Web Payments SDK — same client-side-tokenization rule as Stripe above).
# Leave unset to run with the processor in "not configured" state.
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# Twilio (reminders, "you're next" texts, OTP verification for cross-org client identity)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Calendar (per-staff OAuth, not org-wide)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# QuickBooks Online (Tax & Financial Management sync)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=change_me
