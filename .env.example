# Database
DATABASE_URL=postgres://salon:salon_dev_password@localhost:5432/salon_platform

# Redis (sessions, WebSocket pub/sub, BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Stripe Connect (see SYSTEM-ARCHITECTURE-platform.md §4 — Connect, not plain Stripe,
# because locations/booth-renters each need their own payout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (reminders, "you're next" texts, OTP verification for cross-org client identity)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Calendar (per-staff OAuth, not org-wide)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# QuickBooks Online (Tax & Financial Management sync)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# App
NODE_ENV=development
PORT=3000
SESSION_SECRET=change_me
