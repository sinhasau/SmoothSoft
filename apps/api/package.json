{
  "name": "@salon-platform/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start": "node dist/main.js",
    "seed": "ts-node-dev --transpile-only -r tsconfig-paths/register src/seed.ts",
    "seed:board": "ts-node-dev --transpile-only -r tsconfig-paths/register src/seed-fresh-board.ts",
    "seed:clients": "ts-node-dev --transpile-only -r tsconfig-paths/register src/seed-more-clients.ts",
    "seed:catalog": "ts-node-dev --transpile-only -r tsconfig-paths/register src/seed-more-catalog.ts",
    "seed:staff": "ts-node-dev --transpile-only -r tsconfig-paths/register src/seed-more-staff.ts",
    "seed:tax-identities": "ts-node-dev --transpile-only -r tsconfig-paths/register src/seed-tax-identities.ts",
    "seed:locations-history": "ts-node-dev --transpile-only -r tsconfig-paths/register src/seed-more-locations-history.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "square": "^38.1.0",
    "stripe": "^17.2.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
